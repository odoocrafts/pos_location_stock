<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_location_stock.LocationStockPopup">
        <Dialog>
            <t t-set-slot="header">
                <h3 class="section-title">
                    <t t-esc="props.title"/>
                </h3>
                <button type="button" class="btn-close mb-2" aria-label="Close" tabindex="-1" t-on-click="props.close"/>
            </t>
            <div class="p-3 text-start">
                <t t-if="props.stockData.length > 0">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Location / Warehouse</th>
                                <th class="text-end">Quantity</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="props.stockData" t-as="stock" t-key="stock.name">
                                <tr>
                                    <td><t t-esc="stock.name"/></td>
                                    <td class="text-end fw-bold">
                                        <t t-esc="stock.quantity"/>
                                        <t t-esc="stock.uom"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>
                <t t-else="">
                    <div class="alert alert-info">
                        No stock found in any internal location.
                    </div>
                </t>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary btn-lg lh-lg w-100" t-on-click="props.close">Close</button>
            </t>
        </Dialog>
    </t>
</templates>
